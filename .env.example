# ============================================
# CẤU HÌNH MẪU BIẾN MÔI TRƯỜNG DỰ ÁN
# ============================================

# --------------------------------------------
# LLM cục bộ: Ollama (không cần API key, không gửi dữ liệu ra ngoài)
# Cài Ollama, rồi chạy một lần:  ollama pull qwen3:1.7b
# --------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.3

# Tìm địa điểm gần vị trí đã được người dùng cho phép chia sẻ (km; tự mở rộng tối đa 10 km).
NEARBY_SEARCH_RADIUS_KM=5

# Tùy chọn (đã có giá trị mặc định hợp lý, chỉ đặt khi cần chỉnh):
# Cửa sổ ngữ cảnh. Giữ nhỏ để tiết kiệm RAM; không nên đặt dưới 2048.
# OLLAMA_NUM_CTX=4096
# Thời gian giữ model trong RAM sau lần dùng cuối (10m = 10 phút, 0 = giải phóng ngay).
# OLLAMA_KEEP_ALIVE=10m
# Timeout riêng cho bước phân tích ý định (giây); quá hạn thì dùng mô hình ML cục bộ.
# OLLAMA_ROUTER_TIMEOUT=20
# Chỉ gọi Ollama phân tích ý định khi độ tin cậy của mô hình ML cục bộ thấp hơn ngưỡng này (0-1).
# OLLAMA_ROUTER_THRESHOLD=0.7
# Dữ liệu đã xác minh dài hơn số ký tự này (lịch trình dài...) được giữ nguyên văn, không nhờ LLM viết lại.
# OLLAMA_REWRITE_MAX_CHARS=1500

# Cấu hình kết nối MySQL Database
DATABASE_URL=mysql+pymysql://root:1234@localhost:3306/agentic_local_guide

# Khóa bí mật cho JWT Authentication
SECRET_KEY=agentic-ai-local-guide-secret-key


# Cấu hình Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Đã gộp xung đột Git: dùng 127.0.0.1. Nếu Google Console đang đăng ký "localhost" thì đổi cả ba dòng
# GOOGLE_REDIRECT_URI, FRONTEND_URL, FACEBOOK_REDIRECT_URI sang localhost cho khớp.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# OAuth frontend callback destination (optional when using FastAPI /app frontend)
FRONTEND_URL=http://127.0.0.1:5500

# Facebook Login (optional; configure a Meta app before enabling)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v24.0