# ============================================
# CẤU HÌNH MẪU BIẾN MÔI TRƯỜNG DỰ ÁN
# ============================================

# Google Gemini API Key (tùy chọn; cần để stream câu trả lời bằng token)
# Lấy API Key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Cấu hình kết nối MySQL Database
DATABASE_URL=mysql+pymysql://root:1234@localhost:3306/agentic_local_guide

# Khóa bí mật cho JWT Authentication
SECRET_KEY=agentic-ai-local-guide-secret-key


# Cấu hình Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# OAuth frontend callback destination (optional when using FastAPI /app frontend)
FRONTEND_URL=http://127.0.0.1:5500

# Facebook Login (optional; configure a Meta app before enabling)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v24.0

# Gemini chat text streaming (optional; local grounded planner remains available without a key)
GEMINI_MODEL=gemini-3.8-flash
